<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background">

    <!-- Claude mascot icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_claude_mascot"
        android:contentDescription="Claude"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude Bubble"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/claude_orange"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chatea con Claude mientras usas otras apps"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Status -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        android:layout_marginBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBubbleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Burbuja inactiva ○"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usa tu cuenta de claude.ai — no necesitas API key"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Activate -->
    <Button
        android:id="@+id/btnStartBubble"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Activar burbuja flotante"
        android:textSize="16sp"
        android:backgroundTint="@color/claude_orange"
        android:layout_marginBottom="12dp" />

    <!-- Open chat directly -->
    <Button
        android:id="@+id/btnOpenChat"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Abrir Claude"
        android:textSize="16sp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginBottom="12dp" />

    <!-- Stop -->
    <Button
        android:id="@+id/btnStopBubble"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Detener burbuja"
        android:textSize="14sp"
        android:backgroundTint="@color/error_red"
        android:enabled="false" />

</LinearLayout>
