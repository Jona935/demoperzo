<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClaudeBubble" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/claude_orange</item>
        <item name="colorPrimaryVariant">@color/claude_orange_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
    </style>

    <!-- Transparent theme for ChatActivity (just launches Chrome Custom Tab) -->
    <style name="Theme.Translucent" parent="Theme.ClaudeBubble">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
