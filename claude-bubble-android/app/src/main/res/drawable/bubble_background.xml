<?xml version="1.0" encoding="utf-8"?>
<!-- Circular bubble with Claude's orange color and a subtle "C" letter -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item android:top="4dp" android:left="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/bubble_shadow" />
            <size android:width="62dp" android:height="62dp" />
        </shape>
    </item>
    <!-- Main circle -->
    <item android:bottom="4dp" android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/claude_orange" />
            <size android:width="62dp" android:height="62dp" />
        </shape>
    </item>
    <!-- Inner ring -->
    <item android:bottom="6dp" android:right="6dp" android:top="2dp" android:left="2dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
